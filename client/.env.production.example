# Kopiere diese Datei zu ".env.production", wenn du lokal einen Produktions-
# Build gegen dein online gehostetes Backend testen willst.
#
# Für die automatische Veröffentlichung über GitHub Actions wird diese Datei
# NICHT benötigt - dort wird VITE_API_URL stattdessen als GitHub-Repository-
# Secret gesetzt (Settings -> Secrets and variables -> Actions).

VITE_API_URL=https://dein-backend-name.onrender.com
